filters:
  and:
    - file.ext == "md"
    - file.hasProperty("type")
    - file.name != "Home"
properties:
  note.type:
    displayName: Type
  note.status:
    displayName: Status
  note.updated:
    displayName: Updated
  file.folder:
    displayName: Folder
views:
  - type: table
    name: Decisions
    filters:
      and:
        - note.type == "adr"
    order:
      - file.name
      - status
      - updated
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Needs verification
    filters:
      and:
        - file.hasTag("needs-verification")
    order:
      - file.name
      - type
      - status
      - updated
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: Recently updated
    order:
      - file.name
      - type
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 8
  - type: table
    name: By status
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - file.folder
  - type: table
    name: By folder
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - type
      - status
